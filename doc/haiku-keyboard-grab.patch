+/*!	Asks the app_server to route all keyboard input to this window, including
+	the key combinations that are normally consumed by the system (workspace
+	switching, global shortcuts, the window switcher, and BWindow's own
+	built-in shortcuts).
+
+	Only the window that currently has focus can grab the keyboard. The grab
+	is released automatically as soon as the window loses focus (which
+	includes being hidden, minimized, moved off the current workspace or
+	closed), or when the application quits. The secure attention sequence
+	(Control+Command+Delete, which opens the Team monitor) and the
+	"safe video mode" combination always reach the system.
+
+	
+	\return \c B_OK if the grab was set or released, \c B_NOT_ALLOWED if the
+		window doesn't have focus, or another error code.
+*/
+status_t
+BWindow::SetKeyboardGrab(bool grab)
+{
+	BAutolock locker(this);
+	if (!locker.IsLocked())
+		return B_BAD_VALUE;
+
+	fLink->StartMessage(AS_SET_KEYBOARD_GRAB);
+	fLink->Attach<bool>(grab);
+
+	status_t status;
+	if (fLink->FlushWithReply(status) != B_OK)
+		return B_ERROR;
+
+	return status;
+}
+
+
+bool
+BWindow::HasKeyboardGrab() const
+{
+	BAutolock locker(const_cast<BWindow*>(this));
+	if (!locker.IsLocked())
+		return false;
+
+	fLink->StartMessage(AS_GET_KEYBOARD_GRAB);
+
+	status_t status;
+	if (fLink->FlushWithReply(status) == B_OK)
+		return status == B_OK;
+
+	return false;
+}
