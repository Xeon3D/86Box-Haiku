+/*
+ * GrabTest - logs every keyboard message a window receives, and toggles a
+ * keyboard grab with a mouse click.
+ *
+ * Build against the patched headers (prototype API):
+ *   g++ -o GrabTest GrabTest.cpp -lbe
+ * On a stock Haiku, build with -DNO_GRAB_API: clicking then only logs what
+ * would be grabbed, which is useful as a "before" baseline.
+ *
+ * Output goes to stdout (run it from Terminal) and is drawn in the window.
+ */
+
+#include <Application.h>
+#include <InterfaceDefs.h>
+#include <String.h>
+#include <View.h>
+#include <Window.h>
+
+#include <stdio.h>
+#include <string.h>
+
+
+static const char*
+what_name(uint32 what)
+{
+	switch (what) {
+		case B_KEY_DOWN:			return "KEY_DOWN";
+		case B_KEY_UP:				return "KEY_UP";
+		case B_UNMAPPED_KEY_DOWN:	return "UNMAPPED_KEY_DOWN";
+		case B_UNMAPPED_KEY_UP:		return "UNMAPPED_KEY_UP";
+		case B_MODIFIERS_CHANGED:	return "MODIFIERS_CHANGED";
+		default:					return NULL;
+	}
+}
+
+
+static BString
+modifier_string(uint32 modifiers)
+{
+	BString string;
+	if (modifiers & B_SHIFT_KEY)	string << "Shift ";
+	if (modifiers & B_COMMAND_KEY)	string << "Cmd ";
+	if (modifiers & B_CONTROL_KEY)	string << "Ctrl ";
+	if (modifiers & B_OPTION_KEY)	string << "Opt ";
+	if (modifiers & B_MENU_KEY)		string << "Menu ";
+	return string;
+}
+
+
+class LogView : public BView {
+public:
+	LogView(BRect frame)
+		:
+		BView(frame, "log", B_FOLLOW_ALL, B_WILL_DRAW),
+		fCount(0)
+	{
+		SetViewColor(ui_color(B_DOCUMENT_BACKGROUND_COLOR));
+		SetHighColor(ui_color(B_DOCUMENT_TEXT_COLOR));
+	}
+
+	virtual void AttachedToWindow()
+	{
+		MakeFocus(true);
+	}
+
+	void Log(const char* line)
+	{
+		printf("%s\n", line);
+		fflush(stdout);
+		fLines[fCount % kLines] = line;
+		fCount++;
+		Invalidate();
+	}
+
+	virtual void Draw(BRect)
+	{
+		font_height height;
+		GetFontHeight(&height);
+		float lineHeight = height.ascent + height.descent + height.leading;
+		int32 first = fCount > kLines ? fCount - kLines : 0;
+		float y = lineHeight;
+		for (int32 i = first; i < fCount; i++, y += lineHeight)
+			DrawString(fLines[i % kLines].String(), BPoint(5, y));
+	}
+
+	virtual void MouseDown(BPoint)
+	{
+		BString line;
+#ifdef NO_GRAB_API
+		line = "click: no grab API in this build";
+#else
+		bool grab = !Window()->HasKeyboardGrab();
+		status_t status = Window()->SetKeyboardGrab(grab);
+		line.SetToFormat("click: SetKeyboardGrab(%s) -> %s, HasKeyboardGrab()"
+			" = %s", grab ? "true" : "false", strerror(status),
+			Window()->HasKeyboardGrab() ? "true" : "false");
+		Window()->SetTitle(Window()->HasKeyboardGrab()
+			? "GrabTest - GRABBED (click to release)"
+			: "GrabTest - click to grab");
+#endif
+		Log(line);
+	}
+
+private:
+	static const int32 kLines = 40;
+	BString	fLines[kLines];
+	int32	fCount;
+};
+
+
+class GrabWindow : public BWindow {
+public:
+	GrabWindow()
+		:
+		BWindow(BRect(100, 100, 700, 700), "GrabTest - click to grab",
+			B_TITLED_WINDOW, B_QUIT_ON_WINDOW_CLOSE)
+	{
+		fView = new LogView(Bounds());
+		AddChild(fView);
+	}
+
+	// Log before BWindow gets a chance to handle (and eat) shortcuts
+	virtual void DispatchMessage(BMessage* message, BHandler* target)
+	{
+		const char* name = what_name(message->what);
+		if (name != NULL) {
+			int32 key = message->GetInt32("key", 0);
+			uint32 modifiers = message->GetInt32("modifiers", 0);
+			const char* bytes = message->GetString("bytes", "");
+			BString line;
+			line.SetToFormat("%-18s key=0x%02" B_PRIx32 " bytes=0x%02x "
+				"mods=%s%s", name, key, (uint8)bytes[0],
+				modifier_string(modifiers).String(),
+				message->GetBool("be:keyboard_grab", false)
+					? " [grab]" : "");
+			fView->Log(line);
+		}
+		BWindow::DispatchMessage(message, target);
+	}
+
+	virtual void WindowActivated(bool active)
+	{
+		BString line;
+		line.SetToFormat("WindowActivated(%s)%s", active ? "true" : "false",
+#ifdef NO_GRAB_API
+			"");
+#else
+			HasKeyboardGrab() ? " - still grabbed?!" : "");
+#endif
+		fView->Log(line);
+		if (!active)
+			SetTitle("GrabTest - click to grab");
+	}
+
+private:
+	LogView*	fView;
+};
+
+
+int
+main()
+{
+	BApplication app("application/x-vnd.test-GrabTest");
+	(new GrabWindow())->Show();
+	app.Run();
+	return 0;
+}
