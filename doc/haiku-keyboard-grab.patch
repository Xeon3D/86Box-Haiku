+/*!	Grabs or releases the keyboard for \a window.
+
+	While a window holds the grab, every keyboard event that is routed to it
+	bypasses the global shortcuts of the app_server (workspace switching,
+	desktop listeners), is marked with a "be:keyboard_grab" field (so that
+	BWindow skips its built-in shortcuts), and the input_server is told to
+	mark events for its filter add-ons as well.
+
+	Only the focus window can grab the keyboard, and the grab is released
+	as soon as the window loses focus or is removed. The secure attention
+	sequence (Team monitor) is handled in the input_server's keyboard device
+	before any of this, and is therefore never affected.
+*/
+status_t
+Desktop::SetKeyboardGrab(Window* window, bool grab)
+{
+	if (window == NULL)
+		return B_BAD_VALUE;
+
+	if (!LockAllWindows())
+		return B_ERROR;
+
+	status_t status = B_OK;
+
+	if (grab) {
+		if (window != fFocus || window->IsHidden())
+			status = B_NOT_ALLOWED;
+		else if (fKeyboardGrabWindow != window) {
+			fKeyboardGrabWindow = window;
+			// Notify while still holding the lock, so that the input_server
+			// always sees grab state changes in the right order
+			fEventDispatcher.SetKeyboardGrab(true);
+		}
+	} else if (fKeyboardGrabWindow == window)
+		_ReleaseKeyboardGrab();
+
+	UnlockAllWindows();
+	return status;
+}
+
+
+/*!	Releases the current keyboard grab, if any.
+	You must hold the all window lock when calling this method.
+*/
+void
+Desktop::_ReleaseKeyboardGrab()
+{
+	if (fKeyboardGrabWindow == NULL)
+		return;
+
+	fKeyboardGrabWindow = NULL;
+	fEventDispatcher.SetKeyboardGrab(false);
+}
+
+
+/*!	Returns whether keyboard events for \a target should bypass the global
+	keyboard shortcuts, ie. whether it belongs to the window holding the
+	keyboard grab.
+*/
+bool
+Desktop::IsKeyboardGrabTarget(EventTarget* target)
+{
+	if (target == NULL || !LockSingleWindow())
+		return false;
+
+	bool grabbed = fKeyboardGrabWindow != NULL
+		&& target == &fKeyboardGrabWindow->EventTarget();
+
+	UnlockSingleWindow();
+	return grabbed;
+}
