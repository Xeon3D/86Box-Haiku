#!/bin/bash
#
# haiku-syspatch - rebuild the Haiku system package of the *running* system
# with local patches applied, and optionally install it.
#
#   haiku-syspatch info                         what is installed / running
#   haiku-syspatch doctor [--install-deps]      check build prerequisites
#   haiku-syspatch fetch                        get the source of that hrev
#   haiku-syspatch build [-p patch]... [-t tag] apply patches, build packages
#   haiku-syspatch install [--yes] [dir]        install the built packages
#   haiku-syspatch restore [--yes]              go back to the official packages
#   haiku-syspatch status                       installed vs. built vs. running
#   haiku-syspatch all [-p patch]... [-t tag]   doctor + fetch + build + install
#
# See README.md next to this script for the design.
#
# Environment:
#   HAIKU_SYSPATCH_DIR   work directory (default: ~/haiku-syspatch)
#   HAIKU_SYSPATCH_JOBS  parallel build jobs (default: number of CPUs)
#   HAIKU_GIT_MIRROR     bulk source (default: https://github.com/haiku/haiku)
#   HAIKU_GIT_TAGS       hrev tag source (default: https://review.haiku-os.org/haiku)
#
# Only Haiku's system packages are rebuilt (haiku, haiku_devel and, on hybrid
# systems, haiku_<secondary arch> and its _devel). Patches must therefore
# only touch what those packages contain.

set -o pipefail

PROG=haiku-syspatch
WORK=${HAIKU_SYSPATCH_DIR:-$HOME/haiku-syspatch}
JOBS=${HAIKU_SYSPATCH_JOBS:-$(nproc 2>/dev/null || echo 2)}
MIRROR=${HAIKU_GIT_MIRROR:-https://github.com/haiku/haiku}
TAGS_URL=${HAIKU_GIT_TAGS:-https://review.haiku-os.org/haiku}
SYSPKG=/boot/system/packages
MIN_FREE_GB=8

# Non-login shells (ssh user@host command, cron) have no LIBRARY_PATH. The
# Haiku build runs its host tools with LIBRARY_PATH="$LIBRARY_PATH:<dir>",
# which then drops /boot/system/lib and every tool exits with status 3
# ("Cannot open file libbsd.so" in the syslog). Set up a login environment.
if [ -z "$LIBRARY_PATH" ] && [ -f /boot/system/boot/SetupEnvironment ]; then
	. /boot/system/boot/SetupEnvironment
fi

# git's automatic background maintenance ("git maintenance run --auto",
# pack-refs) was seen hanging on Haiku after a fetch; never run it here.
export GIT_CONFIG_COUNT=2
export GIT_CONFIG_KEY_0=maintenance.auto GIT_CONFIG_VALUE_0=false
export GIT_CONFIG_KEY_1=gc.auto GIT_CONFIG_VALUE_1=0

# ---------------------------------------------------------------- helpers

die()  { echo "$PROG: error: $*" >&2; exit 1; }
warn() { echo "$PROG: warning: $*" >&2; }
note() { echo "==> $*"; }

confirm()
{
	# confirm "question" - honours --yes
	[ "$ASSUME_YES" = 1 ] && return 0
	local answer
	read -r -p "$1 [y/N] " answer
	case $answer in [yY]|[yY][eE][sS]) return 0;; *) return 1;; esac
}

is_haiku() { [ "$(uname -s)" = Haiku ]; }

# Prints "key=value" lines describing one hpkg file.
hpkg_field()
{
	package list -i "$1" 2>/dev/null \
		| sed -n "s/^[[:space:]]*$2:[[:space:]]*//p" | head -1
}

# The installed base system package (haiku-<version>-<arch>.hpkg).
installed_haiku_hpkg()
{
	local f
	for f in "$SYSPKG"/haiku-*.hpkg; do
		[ -e "$f" ] || continue
		[ "$(hpkg_field "$f" name)" = haiku ] && { echo "$f"; return 0; }
	done
	return 1
}

# Parses a Haiku system package version such as
#   r1~beta6_hrev59866_92-1           (beta branch, 92 commits after the tag)
#   r1~beta5_hrev58210-1              (nightly built from a tag)
#   r1~beta6_hrev59866_101_kbgrab-1   (rebuilt by this tool, tag "kbgrab")
# into the globals V_SERIES, V_HREV, V_COUNT, V_TAG, V_PKGREV.
parse_version()
{
	local v=$1 rest
	V_PKGREV=${v##*-}
	v=${v%-*}
	V_SERIES=${v%%_hrev*}
	rest=${v#*_hrev}
	[ "$rest" != "$v" ] || return 1
	V_HREV=hrev${rest%%_*}
	V_COUNT=0
	V_TAG=
	case $rest in
		*_*)
			rest=${rest#*_}
			case ${rest%%_*} in
				*[!0-9]*) V_TAG=$rest ;;
				*) V_COUNT=${rest%%_*}
				   [ "$rest" != "${rest#*_}" ] && V_TAG=${rest#*_} ;;
			esac
			;;
	esac
	return 0
}

load_system_info()
{
	is_haiku || die "this must run on Haiku"
	HPKG=$(installed_haiku_hpkg) || die "no haiku-*.hpkg in $SYSPKG"
	ARCH=$(hpkg_field "$HPKG" architecture)
	VERSION=$(hpkg_field "$HPKG" version)
	parse_version "$VERSION" || die "can't parse system version '$VERSION'"
	RUNNING=$(uname -v | awk '{print $1}')
	SECONDARY=
	local a
	for a in x86 x86_gcc2; do
		ls "$SYSPKG"/haiku_${a}-*.hpkg >/dev/null 2>&1 && SECONDARY="$SECONDARY $a"
	done
	SECONDARY=${SECONDARY# }
	HAVE_DEVEL=0
	ls "$SYSPKG"/haiku_devel-*.hpkg >/dev/null 2>&1 && HAVE_DEVEL=1
	BASE_ID=${V_HREV}_${V_COUNT}
	SRC=$WORK/$BASE_ID/haiku
	OUT=$WORK/$BASE_ID/out
}

# Branch candidates for a version series: r1~beta6 -> r1beta6, then master.
branch_candidates()
{
	local b
	case $V_SERIES in
		r1~beta*|r1~alpha*) b=$(echo "$V_SERIES" | tr -d '~'); echo "$b" ;;
	esac
	echo master
}

free_gb()
{
	df "$1" 2>/dev/null | sed -n 's/^ *Free Blocks: *\([0-9.]*\) GiB.*/\1/p' \
		| cut -d. -f1
}

# ---------------------------------------------------------------- commands

cmd_info()
{
	load_system_info
	cat <<EOF
Installed system package : $(basename "$HPKG")
  version                : $VERSION
  series / base tag      : $V_SERIES / $V_HREV (+$V_COUNT commits)
  local build tag        : ${V_TAG:-none (official build)}
  architecture           : $ARCH${SECONDARY:+ (secondary: $SECONDARY)}
  haiku_devel installed  : $([ $HAVE_DEVEL = 1 ] && echo yes || echo no)
Running kernel revision  : $RUNNING
Branch candidates        : $(branch_candidates | tr '\n' ' ')
Work directory           : $WORK/$BASE_ID
EOF
	local expect=$V_HREV
	[ "$V_COUNT" != 0 ] && expect="$expect+$V_COUNT"
	[ -n "$V_TAG" ] && expect="$expect+$V_TAG"
	if [ "${RUNNING%%+*}" != "$V_HREV" ] || [ "$RUNNING" != "$expect" ]; then
		warn "the running kernel ($RUNNING) differs from the installed package" \
			"($expect): a system update is probably pending a reboot."
	fi
}

# What building the cross tools and the system packages on Haiku needs
# (the host gcc only builds the cross gcc and the host tools). Images would
# also need mtools and xorriso, but this tool only builds packages.
DEPS="cmd:git cmd:jam cmd:gcc cmd:make cmd:nasm cmd:bison cmd:flex cmd:m4
	cmd:makeinfo cmd:autoconf cmd:automake cmd:gawk cmd:python3
	devel:libzstd devel:libz"

cmd_doctor()
{
	load_system_info
	local missing= d
	for d in $DEPS; do
		case $d in
			cmd:*)
				command -v "${d#cmd:}" >/dev/null 2>&1 || missing="$missing $d" ;;
			devel:*)
				ls /boot/system/develop/lib/"${d#devel:}".so >/dev/null 2>&1 \
					|| missing="$missing $d" ;;
			*)
				ls "$SYSPKG"/$d-*.hpkg >/dev/null 2>&1 || missing="$missing $d" ;;
		esac
	done
	if [ -n "$missing" ]; then
		echo "Missing build prerequisites:$missing"
		if [ "$INSTALL_DEPS" = 1 ]; then
			# No -y: pkgman shows its plan (which can include upgrades of
			# packages already installed) and asks first.
			pkgman install $missing || die "installing prerequisites failed"
		else
			echo "Install them with:  pkgman install$missing"
			echo "(or run: $PROG doctor --install-deps)"
			return 1
		fi
	else
		echo "All build prerequisites are installed."
	fi

	mkdir -p "$WORK"
	local gb
	gb=$(free_gb "$WORK")
	if [ -n "$gb" ] && [ "$gb" -lt $MIN_FREE_GB ]; then
		warn "only ${gb} GiB free on the volume of $WORK;" \
			"a build needs about $MIN_FREE_GB GiB"
	fi
	[ "$ARCH" = x86_64 ] || [ "$ARCH" = x86 ] \
		|| warn "architecture $ARCH is untested with this tool"
	[ -n "$SECONDARY" ] && warn "hybrid system: secondary architecture" \
		"packages will be built as well, which takes noticeably longer"
	return 0
}

# Finds the commit that the installed package was built from.
resolve_commit()
{
	# Prints "<commit> <branch>".
	local tag=$1 count=$2 branch c n
	for branch in $(branch_candidates); do
		git -C "$SRC" rev-parse -q --verify "origin/$branch" >/dev/null \
			|| continue
		git -C "$SRC" merge-base --is-ancestor "$tag" "origin/$branch" \
			2>/dev/null || continue
		if [ "$count" = 0 ]; then
			echo "$(git -C "$SRC" rev-parse "$tag^{commit}") $branch"
			return 0
		fi
		# Walk the first-parent chain from the tag; the build revision
		# "hrevX+N" is "git describe" = hrevX-N-g<sha>.
		c=$(git -C "$SRC" rev-list --first-parent --reverse \
			"$tag..origin/$branch" | sed -n "${count}p")
		[ -n "$c" ] || continue
		n=$(git -C "$SRC" rev-list --count "$tag..$c")
		if [ "$n" = "$count" ] \
			&& git -C "$SRC" describe --tags --match='hrev*' "$c" \
				| grep -q "^$tag-$count-g"; then
			echo "$c $branch"
			return 0
		fi
	done
	return 1
}

cmd_fetch()
{
	load_system_info
	mkdir -p "$WORK/$BASE_ID"
	if [ ! -d "$SRC/.git" ]; then
		note "Cloning $MIRROR (history only, file contents on demand)"
		git clone --filter=blob:none --no-checkout "$MIRROR" "$SRC" \
			|| die "clone failed"
	else
		note "Updating $SRC"
		git -C "$SRC" fetch -q origin || die "fetch failed"
	fi

	# The GitHub mirror has no hrev tags; get the one we need from Haiku.
	note "Fetching tag $V_HREV from $TAGS_URL"
	git -C "$SRC" fetch -q "$TAGS_URL" \
		"refs/tags/$V_HREV:refs/tags/$V_HREV" || die "can't fetch $V_HREV"

	local resolved commit branch
	resolved=$(resolve_commit "$V_HREV" "$V_COUNT") \
		|| die "can't find the commit for $V_HREV+$V_COUNT on:" \
			"$(branch_candidates | tr '\n' ' ')"
	commit=${resolved% *}
	branch=${resolved#* }
	note "System was built from $commit ($V_HREV+$V_COUNT on $branch)"
	echo "$commit" > "$WORK/$BASE_ID/base-commit"
	echo "$branch" > "$WORK/$BASE_ID/base-branch"

	git -C "$SRC" checkout -q -B "syspatch/$BASE_ID" "$commit" \
		|| die "checkout failed"
	note "Source ready in $SRC"
}

cmd_build()
{
	load_system_info
	[ -n "$V_TAG" ] && die "the installed system is already a local build" \
		"($VERSION). Run '$PROG restore' and reboot first, so the patches" \
		"are applied to the official source."
	[ -f "$WORK/$BASE_ID/base-commit" ] && [ -f "$WORK/$BASE_ID/base-branch" ] \
		|| cmd_fetch
	local base
	base=$(cat "$WORK/$BASE_ID/base-commit")

	BUILD_TAG=$(echo "${BUILD_TAG:-syspatch}" | tr 'A-Z' 'a-z' | tr -cd 'a-z0-9')
	[ -n "$BUILD_TAG" ] || die "the tag must contain letters or digits"
	[ ${#PATCHES[@]} -gt 0 ] || die "no patches given (use -p <file>)"

	note "Resetting source to $base and applying ${#PATCHES[@]} patch(es)"
	git -C "$SRC" checkout -q -B "syspatch/$BASE_ID" "$base" || die "checkout"
	git -C "$SRC" reset -q --hard "$base"
	local p
	for p in "${PATCHES[@]}"; do
		[ -f "$p" ] || die "no such patch: $p"
		note "  $p"
		if head -1 "$p" | grep -q '^From [0-9a-f]\{40\} '; then
			git -C "$SRC" -c user.name="$PROG" -c user.email=none@localhost \
				am -q --3way "$(realpath "$p")" || die "patch failed: $p"
		else
			git -C "$SRC" apply --3way --index "$(realpath "$p")" \
				|| die "patch failed: $p"
			git -C "$SRC" -c user.name="$PROG" -c user.email=none@localhost \
				commit -q -m "$PROG: $(basename "$p")" || die "commit failed"
		fi
	done

	# Build with Haiku's own cross tools from the branch's buildtools, not
	# with the native gcc:
	#  - the system package contains the 32-bit BIOS/PXE boot loaders, and
	#    the native x86_64 gcc has no 32-bit libgcc to link them;
	#  - the branch pins gcc_syslibs_devel to one gcc version, and its
	#    headers don't work with a different native gcc (GCC 15 vs. 13).
	# The tools are built once per branch and reused.
	case $ARCH in
		x86_64) ;;
		*) die "only x86_64 systems are supported (this is $ARCH)" ;;
	esac
	local branch tools
	branch=$(cat "$WORK/$BASE_ID/base-branch" 2>/dev/null) \
		|| die "run '$PROG fetch' again (no base-branch recorded)"
	tools=$WORK/buildtools-$branch
	if [ ! -d "$tools/.git" ]; then
		note "Cloning buildtools ($branch)"
		git clone -q --depth 1 -b "$branch" "${MIRROR%/haiku}/buildtools" \
			"$tools" 2>/dev/null \
			|| git clone -q --depth 1 "${MIRROR%/haiku}/buildtools" "$tools" \
			|| die "can't clone buildtools"
	fi

	local revision=$V_HREV
	[ "$V_COUNT" != 0 ] && revision="$revision+$V_COUNT"
	revision="$revision+$BUILD_TAG"
	local gen=$SRC/generated.$ARCH config="cross:$branch"
	if [ -d "$gen" ] && [ "$(cat "$gen/syspatch-config" 2>/dev/null)" != "$config" ]; then
		note "Build directory was set up differently, starting from scratch"
		rm -rf "$gen"
	fi
	mkdir -p "$gen"
	if [ ! -f "$gen/build/BuildConfig" ]; then
		note "Building the cross tools and configuring (once per branch;"
		note "this takes a long time; log: $gen/syspatch-configure.log)"
		(cd "$gen" && ../configure -j"$JOBS" --cross-tools-source "$tools" \
			--build-cross-tools "$ARCH") > "$gen/syspatch-configure.log" 2>&1 \
			|| { tail -30 "$gen/syspatch-configure.log"; die "configure failed"; }
		echo "$config" > "$gen/syspatch-config"
	fi

	local targets="haiku.hpkg haiku_devel.hpkg" a
	for a in $SECONDARY; do
		targets="$targets haiku_$a.hpkg haiku_${a}_devel.hpkg"
	done
	note "Building $targets as $revision with $JOBS jobs"
	note "(log: $gen/syspatch-build.log; this takes a while)"
	local start=$SECONDS
	(cd "$gen" && jam -q -j"$JOBS" -sHAIKU_REVISION="$revision" $targets) \
		> "$gen/syspatch-build.log" 2>&1 \
		|| { tail -30 "$gen/syspatch-build.log"; die "build failed"; }

	local version=${V_SERIES}_$(echo "$revision" | sed 's/[+-]/_/g')
	local dest=$OUT/$version
	rm -rf "$dest"; mkdir -p "$dest"
	local t f
	for t in $targets; do
		f=$(find "$gen/objects/haiku" -path '*/packaging/packages/*' \
			-name "${t%.hpkg}.hpkg" | head -1)
		[ -n "$f" ] || die "built package $t not found"
		cp "$f" "$dest/${t%.hpkg}-$version-1-$ARCH.hpkg"
	done
	{
		echo "base_version=$VERSION"
		echo "base_commit=$base"
		echo "build_revision=$revision"
		echo "package_version=$version-1"
		echo "built=$(date)"
		for p in "${PATCHES[@]}"; do
			echo "patch=$(basename "$p") sha256=$(sha256sum "$p" | cut -d' ' -f1)"
		done
	} > "$dest/MANIFEST"
	echo "$dest" > "$OUT/latest"
	note "Built in $(( (SECONDS - start) / 60 )) min:"
	ls -l "$dest"
}

cmd_install()
{
	load_system_info
	local dir=${1:-$(cat "$OUT/latest" 2>/dev/null)}
	[ -d "$dir" ] || die "nothing built yet (run '$PROG build')"
	. <(grep '^base_version=\|^package_version=' "$dir/MANIFEST")
	if [ "$base_version" != "$VERSION" ] && [ "$FORCE" != 1 ]; then
		die "packages in $dir were built for $base_version, but $VERSION" \
			"is installed (use --force to install anyway)"
	fi

	local files=() f
	for f in "$dir"/*.hpkg; do
		case $(basename "$f") in
			haiku_devel-*|haiku_*_devel-*) [ $HAVE_DEVEL = 1 ] || continue ;;
		esac
		files+=("$f")
	done

	# Keep the official packages so 'restore' needs no network.
	mkdir -p "$WORK/backup"
	for f in "$SYSPKG"/haiku-*.hpkg "$SYSPKG"/haiku_devel-*.hpkg \
			"$SYSPKG"/haiku_x86*.hpkg; do
		[ -e "$f" ] && cp -n "$f" "$WORK/backup/"
	done

	echo "This replaces the system packages"
	echo "    $VERSION  ->  $package_version"
	printf '    %s\n' "${files[@]##*/}"
	echo "The change takes effect after a reboot. If the new system misbehaves,"
	echo "choose an earlier state in the boot loader (hold Shift while booting,"
	echo "'Select system state'), then run '$PROG restore'."
	confirm "Install now?" || { echo "Not installed."; return 1; }
	pkgman install -y "${files[@]}" || die "pkgman failed"
	note "Installed. Reboot to activate."
}

cmd_restore()
{
	load_system_info
	[ -n "$V_TAG" ] || { echo "The official system packages are installed."; return 0; }
	local files=() f want=${V_SERIES}_${V_HREV}
	[ "$V_COUNT" != 0 ] && want=${want}_$V_COUNT
	for f in "$WORK"/backup/haiku-"$want"-*.hpkg \
			"$WORK"/backup/haiku_devel-"$want"-*.hpkg \
			"$WORK"/backup/haiku_x86*-"$want"-*.hpkg; do
		[ -e "$f" ] || continue
		case $(basename "$f") in
			haiku_devel-*) [ $HAVE_DEVEL = 1 ] || continue ;;
		esac
		files+=("$f")
	done
	if [ ${#files[@]} -gt 0 ]; then
		echo "Reinstall the official packages from $WORK/backup:"
		printf '    %s\n' "${files[@]##*/}"
		confirm "Restore now?" || return 1
		pkgman install -y "${files[@]}" || die "pkgman failed"
	else
		echo "No backup of the official packages for $want was found."
		echo "Restore from the package repository instead (this may also"
		echo "update to a newer official revision)."
		confirm "Run 'pkgman full-sync'?" || return 1
		pkgman full-sync || die "pkgman failed"
	fi
	note "Done. Reboot to activate."
}

cmd_status()
{
	cmd_info
	local latest
	latest=$(cat "$OUT/latest" 2>/dev/null)
	if [ -n "$latest" ] && [ -f "$latest/MANIFEST" ]; then
		echo "Last local build         : $latest"
		sed 's/^/    /' "$latest/MANIFEST"
	else
		echo "Last local build         : none for $BASE_ID"
	fi
}

usage()
{
	sed -n '3,16p' "$0" | sed 's/^# \{0,1\}//'
	exit "${1:-0}"
}

# ---------------------------------------------------------------- main

COMMAND=$1
[ -n "$COMMAND" ] || usage 1
shift
PATCHES=()
POSITIONAL=()
while [ $# -gt 0 ]; do
	case $1 in
		-p|--patch)		PATCHES+=("$2"); shift 2 ;;
		-t|--tag)		BUILD_TAG=$2; shift 2 ;;
		-j|--jobs)		JOBS=$2; shift 2 ;;
		-y|--yes)		ASSUME_YES=1; shift ;;
		--force)		FORCE=1; shift ;;
		--install-deps)	INSTALL_DEPS=1; shift ;;
		-h|--help)		usage 0 ;;
		-*)				die "unknown option $1" ;;
		*)				POSITIONAL+=("$1"); shift ;;
	esac
done

case $COMMAND in
	info)		cmd_info ;;
	doctor)		cmd_doctor ;;
	fetch)		cmd_fetch ;;
	build)		cmd_build ;;
	install)	cmd_install "${POSITIONAL[0]}" ;;
	restore)	cmd_restore ;;
	status)		cmd_status ;;
	all)		cmd_doctor && cmd_fetch && cmd_build && cmd_install ;;
	-h|--help|help)	usage 0 ;;
	*)			die "unknown command '$COMMAND' (try --help)" ;;
esac
